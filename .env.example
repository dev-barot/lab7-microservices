# API Gateway Configuration & Service Discovery
PORT=8080

# Microservice Locations (Service Registry)
# In Local Docker Compose:
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# In Cloud Deployment (e.g. Railway):
# USER_SERVICE_URL=https://<user-service-railway-url>
# PRODUCT_SERVICE_URL=https://<product-service-railway-url>
# ORDER_SERVICE_URL=https://<order-service-railway-url>
